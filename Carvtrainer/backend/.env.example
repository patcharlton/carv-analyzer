# CARV Analyzer Backend Configuration
# Copy this file to .env and add your API key

# Get your API key from: https://console.anthropic.com/
# 1. Sign in or create an account
# 2. Go to API Keys section
# 3. Create a new key and copy it here

ANTHROPIC_API_KEY=your_api_key_here

# Site password (the app refuses requests until this and SECRET_KEY are set)
APP_PASSWORD=choose_a_password
# Any long random string; signs login tokens. e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me
